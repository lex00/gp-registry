format = "byte-rows"
region = "prg"
offset = 0x0626
count = 1
width = 24

[[asset]]
name = "kong_throw"
format = "byte-rows"
region = "prg"
offset = 0x063F
count = 1
width = 24

[[asset]]
name = "kong_stand"
format = "byte-rows"
region = "prg"
offset = 0x0658
count = 1
width = 24

[[asset]]
name = "kong_beat_a"
format = "byte-rows"
region = "prg"
offset = 0x0671
count = 1
width = 24

[[asset]]
name = "kong_beat_b"
format = "byte-rows"
region = "prg"
offset = 0x068A
count = 1
width = 24

