# Asset map for Donkey Kong (donkey-kong-ju): its two pattern tables, the
# stage screens with their palettes, 25m's ladders and Kong's poses. Each
# span names the routine that reads it, found by tracing the PRG (there's no
# disassembly to cite).
schema = 1
source = "donkey-kong-ju"
title = "Donkey Kong"
sha256 = "aa408f5a6b97c0d738e7e8b489a5617ad4a9ecdee2b05c4ee504210ce31b2825"

# 8KB of CHR ROM, two pattern tables of 256 tiles. The game sets PPUCTRL to
# $94 in play: sprites from the first table, the background from the
# second. The background's digits are tiles 0 to 9 (the score, bonus and
# lives the status routine writes to rows 3 and 5), A to Z $0A-$23, $24 blank.
[[asset]]
name = "sprite_tiles"
format = "chr-2bpp"
region = "chr"
offset = 0x0000
tiles = 256
tiles_per_row = 16

[[asset]]
name = "tiles"
format = "chr-2bpp"
region = "chr"
offset = 0x1000
tiles = 256
tiles_per_row = 16
charset = [[0x00, "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ "]]

# The stage screens: PPU update strings the draw routine at $F1F0 walks to
# draw a stage (found by tracing the PRG reads while 25m is drawn, frame
# 985 of the fall-too-far probe clip). 25m draws strings 0 and 4, and the
# title routine string 3 ($C807 with 8: the pointer at $C4AF). The others
# are drawn for other screens, not identified yet.
[[asset]]
name = "stage_screens"
format = "ppu-strings"
region = "prg"
offset = 0x355B
size = 1258
end = 0x00
entry = [
  { name = "screen_25m", note = "drawn for 25m: palettes, attributes, girders, ladders" },
  { name = "screen_100m", note = "drawn for 100m: the string the pointer at $C4A7 names for $53 = 4 ($F71C): girders, ladders, rivets, the prizes and Pauline's platform" },
  { name = "screen_75m", note = "drawn for 75m: the string the pointer at $C4A7 names for $53 = 3 ($F7CD)" },
  { name = "screen_title", note = "drawn by the title routine ($C914-$C91E): its palettes, DONKEY KONG in blocks, the four menu lines and the copyright" },
  { name = "screen_25m_more", note = "drawn for 25m after screen_25m: the status box" },
]
embed = [{ asset = "palettes_25m", offset = 0x355E, size = 32 }]

# 25m's palettes, the first update of screen_25m ($3F00, 32 bytes): four
# for the background, then four for sprites (Mario 0, Pauline 1, the
# fireballs and the oil drum's fire 2, barrels and hammers 3).
[[asset]]
name = "palettes_25m"
format = "palette"
region = "prg"
offset = 0x355E
count = 8

# Each stage's ladders, as the ladder routine at $D28B reads them: a list of
# 3-byte rows, x, y and a shape, ended by $FE, picked by stage through the
# pointer table at $C47B ($C0E3 for 25m), and the shapes through $C483
# ($C10B for 25m): rows of four bytes, the box's left, top, right and bottom
# from the ladder's x and y. $D8AD tests Mario's feet box against each
# (traced from hammer session clip 4, frames 7508 to 7513).
[[asset]]
name = "ladders_25m"
format = "byte-rows"
region = "prg"
offset = 0x00E3
count = 13
width = 3

[[asset]]
name = "ladder_shapes_25m"
format = "byte-rows"
region = "prg"
offset = 0x010B
count = 7
width = 4

# The sound driver's data: the effects' pitch tables, the note periods,
# the length tables, the songs' headers and notes and the jingles' start
# table, $FAE5 to $FFD3, read by the driver at $FA48-$FE58 (traced reads of
# the user's play and run 5658S). The dk_sound hook reads it by CPU address
# from $FAE5 up.
[[asset]]
name = "sound_rom"
format = "table"
count = 1263
column = [
  { name = "byte", region = "prg", offset = 0x3AE5 },
]

# The jingles, $FFD4 to $FFF8, which the driver reads through $F5 and $F6:
# its loads at $FD2B and $FD2F give $FFD4. 37 bytes, the same as the first
# 37 of donkey-kong-oe's at $8340, which has 5 more: a jingle its start
# table names for jingle 2 ($FFCF is $25 there, 0 here). The dk_sound hook
# reads the table from the address those loads give (its rom_low table).
[[asset]]
name = "sound_jingles"
format = "table"
count = 37
column = [
  { name = "byte", region = "prg", offset = 0x3FD4 },
]

# The attract demo's script: 20 entries, each a direction ($56: 1 right, 2
# left, 4 down, 8 up, 0 none, 5 a jump) and the frames it holds for. The
# demo routine $EBDA loads entry $050E from $C014 (way) and $C028 (frames)
# when its count $050C runs out.
[[asset]]
name = "demo_script"
format = "table"
count = 20
column = [
  { name = "way", region = "prg", offset = 0x0014 },
  { name = "frames", region = "prg", offset = 0x0028 },
]

# Kong's poses. Kong is background tiles, not sprites: the routine at
# $EB06 picks a pose and $C815 queues it for the name table at $2084 (row
# 4, column 4) through the pointer table at $C03C. Each pose is a size byte
# ($46: 4 rows, 6 columns, not lifted) and then 24 tile numbers, a column
# at a time from the top left. $EB54 shows them by the throw timer $36 and
# the slow timer $44: `kong_take` at $36 = 24, `kong_hold` at $36 = 0,
# `kong_throw` once a held barrel is let go ($0515 set by $DB1B), then
# `kong_beat_a` at $44 = $13 and $0B, `kong_beat_b` at $0F and $08, and
# `kong_stand` at $04 (frames 351 to 3160 of recording dk-clear-25m).
[[asset]]
name = "kong_take"
format = "byte-rows"
region = "prg"
offset = 0x060D
count = 1
width = 24

[[asset]]
