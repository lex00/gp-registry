# Probe recipes for Donkey Kong: Original Edition (`gp mechanic probe
# donkey-kong-oe`, crates/gp-cli/src/probe.rs), as donkey-kong-ju's
# probes.toml: a start and presses that reproduce a session's clips, and the
# measures read from RAM, each with the value it must have.

# RAM addresses, as donkey-kong-ju's probes.toml names them, and the clear
# scene's bytes.
[watch]
state = 0x96      # Mario: 1 walk, 2 climb, 4 jump, 8 off an edge, 10 hammer, 255 dying
x = 0x46          # Mario's x (his sprite's less 5)
y = 0x47          # Mario's y
fall = 0x95       # $FF once a jump has come 16 px below its takeoff
death = 0x98      # the death's spin step; 255 when the spin ends
step = 0x88       # the 15-frame walk counter
stage = 0x53      # 1 on 25m, 3 on 75m
floor = 0x59      # the girder Mario is on, 1 (the bottom) to 7 (Pauline's), from his y + 8
mode = 0x4F       # 0 until play starts, 1 in play
lives = 0x55
nogame = 0x4E    # 1 with no game in play: the demo, the last life's wait, GAME OVER
divider = 0x34    # the 11-frame divider, 10 down to 0
throw = 0x36      # Kong's throw timer
drop = 0x37       # Kong's drop timer
straight = 0x43   # the straight barrel's slow timer
slow = 0x45       # the bonus's slow timer
bonus = 0x2E      # the bonus timer, packed BCD hundreds
score_hi = 0x25   # the score, packed BCD
score_mid = 0x26
score_lo = 0x27
drum = 0xAD       # the oil drum: 0 unlit, 2, then 3
hammer = 0x3F     # the hammer timer
pose = 0x9F       # the hammer's pose, 1 to 6
smash = 0xBF      # the smash's step counter
slot0 = 0x5E      # barrel slot 0's state ($80 held, $C0 straight down, 1 rolling)
slot1 = 0x5F
pause = 0x516
pause_lock = 0x517
no_game = 0x4E    # 1 on the title (and from a last life's spin end), 0 in a game ($C9CB)
cursor = 0x511    # the title's cursor sprite's y: 127, 143, 159, 175 for its four lines ($C96A)
idle = 0x44       # the title's idle timer, slow: 32 at the title, 64 after Select ($C93B, $C95D)
attract = 0x58    # 1 while the attract demo plays ($C957)
mode_ab = 0x50    # the menu line chosen, 0 to 3: bit 0 game B, bit 1 two players ($C9A0)
players = 0x51    # 24 for one player, 28 for two ($C9A6, $C9AD)
player = 0x52     # whose turn: 0 player 1, 1 player 2 ($D156)
script = 0x50E    # the demo script's next entry ($EC25)
drawn = 0x510     # 0 until the title is drawn, then 56 ($C938)
p1_lives = 0x404  # player 1's lives, kept while player 2 plays ($CAB9)
p2_lives = 0x405
p1_over = 0x406   # 1 once player 1's game is over ($CA7D)
p2_over = 0x407
p2_score_mid = 0x2A  # player 2's score, packed BCD at $29-$2B ($CC15)
swing_idle = 0xA2  # the hammer's standing swing shift ($D6E8)
mpose = 0x201     # the first tile of Mario's sprite: the picture last drawn
sx = 0x203        # Mario's sprite x: his x less 5
sy = 0x200        # Mario's sprite y: his y less 5
drum_timer = 0x38 # the oil drum's frame timer
fire1_x = 0x223   # fire slot 1's sprite x
fire1_y = 0x220   # fire slot 1's sprite y
fire1_state = 0xB0 # fire slot 1's state ($AF,X for X = 1)
turn = 0x85       # the walk's picture's way from 4 ($D268, $D273; 0 at $D4EB)
cstep = 0x5C      # the climb's step ($D3FB, $D49F)
drop_to = 0xC0    # where a barrel dropping through a crowded girder stops ($DFC0)
loop = 0x5D       # the barrel loop's slot; the smashed barrel's while it breaks ($ED24)
clearing = 0x9A   # 1 from the goal until the next stage's setup clears it ($D08C, $CC47); donkey-kong-ju clears it at the goal ($D0BD)
scene = 0x450     # the clear scene's step ($8A81): 1 at the goal, 2 on its 2nd divider wrap, 3 on its 5th, 4 on its 21st
wait = 0x43       # the clear scene's script: 141 at the goal ($D0B5), one less a divider wrap
mst0 = 0x48E      # 50m: the left moving ladder's state (0 up, 1 going down, 2 down, 3 going up)
mst1 = 0x48F      # the right one's
conv_low = 0x483  # 50m: the lowest conveyor's way, 0 right and 1 left
pie0_y = 0x230    # 50m: pie slot 0's sprite y ($FF free)
pie0_x = 0x233
pts1 = 0x41       # the points sprites' timers
pts2 = 0x42
ae = 0xAE          # the fire loop's slot: the fire the hammer hit while a smash runs ($ED38)
rivet0 = 0xC1      # 100m: rivet k pulled, $C1 + k ($EEBC sets it), girder 2's left and right (pulled near x 64 and 184) are 0 and 1, then 3 and 2 on girder 3, 4 and 5 on 4, 6 and 7 on 5
rivet1 = 0xC2
rivet2 = 0xC3
rivet3 = 0xC4
rivet4 = 0xC5
rivet5 = 0xC6
rivet6 = 0xC7
rivet7 = 0xC8
loops = 0x54       # the round less 1: $C9EA clears it at a game's start; 100m's clear raises it
prize0 = 0xC9      # 75m and 100m: prize k taken, $C9 + k ($EF12)
prize1 = 0xCA
prize2 = 0xCB
hflag0 = 0x451     # the lower hammer's flag ($D7D5 clears it when its hammer goes; $CC47 sets it)
hflag1 = 0x452     # the upper hammer's
hy0 = 0x2D0        # the lower hammer's sprite y ($02D0)
hy1 = 0x2D8        # the upper hammer's sprite y ($02D8)

# ---- The stage clear ----------------------------------------------------
#
# The planned run of donkey-kong-ju's clear-25m clip 1 dies on this ROM at
# frame 2156, since the random bytes differ. This run, found by a search
# over the waits before each ladder (2026-11-04), climbs the ladders at x
# 113, 201, 89 and 201 and Pauline's at x 145 (her girder is reached only
# by it, so Mario's sprite x is 140 at the goal and the clear's picture is
# mirrored, $839E), after a wait of W frames on the fifth girder, which
# gives the goal another bonus. Each plays the clear scene to the next
# stage's setup ($CC47).
[[probe]]
id = "clear-25m"
session = "clear-25m-scene"
clips = [1, 2, 3]
note = "25m cleared by Pauline's ladder at x 145: the goal ($D04C) moves $53 to 2 (50m) and sets $43 to 141 and $9A to 1, which stays set with $4F through the scene ($D0BB returns); the scene's steps $0450 come the frame after its 2nd, 5th and 21st divider wraps, the tally on the 9th, and the next stage's setup clears $9A 396 frames after the scene's first wrap"
base = { path = "1854103de2df3e3047a7934c814152bf6eb53e64fa112426b9561eb915bd412b", at = 1532 }
steps = [
  ". 0",
  "walk_to x 113 max 400",
  "until state == 2 U max 30",
  "until state != 2 U max 400",
  ". 2",
  ". 0",
  "walk_to x 201 max 400",
  "until state == 2 U max 30",
  "until state != 2 U max 400",
  ". 2",
  ". 32",
  "walk_to x 89 max 400",
  "until state == 2 U max 30",
  "until state != 2 U max 400",
  ". 2",
  ". 24",
  "walk_to x 201 max 400",
  "until state == 2 U max 30",
  "until state != 2 U max 400",
  ". 2",
  ". {W}",
  "walk_to x 145 max 400",
  "until state == 2 U max 30",
  "until stage != 1 U max 400",
  "mark",
  "until clearing == 0 . max 600"]
sweep = { W = [0, 192, 112] }
check = [
  { measure = "first stage == 2", expect_each = [2646, 2838, 2758] },
  { measure = "min x while stage == 2", expect = 145 },
  { measure = "max x while stage == 2", expect = 145 },
  { measure = "count mode == 0", expect = 0, note = "$4F stays 1 through the scene" },
  { measure = "values scene at changes scene", expect = [1, 2, 3, 4, 0] },
  { measure = "pairs wait == 139 then scene == 2", expect = [1], note = "the scene acts the frame after the wrap" },
  { measure = "between wait == 140 then clearing == 0", expect = 396 },
  { measure = "min bonus", expect_each = [0x37, 0x36, 0x36], note = "the bonus at the goal, packed BCD hundreds, until the setup puts it back" },
  { measure = "values score_mid at changes score_mid", expect_each = [[0x37], [0x36], [0x36]], note = "the tally, on the scene's 9th wrap" },
]

