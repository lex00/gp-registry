[package]
name = "gp-ext-dk"
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
publish = false
license = "Apache-2.0"

# Donkey Kong's hand-written behavior behind the model's `ext` hooks: Donkey
# Kong throwing barrels and a barrel's own machine on 25m. It depends on
# gp-sim, so the interpreter and a generated project link the same code,
# and gp-cycles, which has no dependencies, for the cycles of a routine's
# path read from the lifted code (gp_cycles::walk).
[dependencies]
gp-sim = { path = "../../../gameprinter/crates/gp-sim" }
gp-cycles = { path = "../../../gameprinter/crates/gp-cycles" }

[lints.rust]
unsafe_code = "forbid"

[workspace]
