# The level kit's rules for Donkey Kong's 25m stage (docs/level-kit.md),
# written by hand. `gp level kit donkey-kong-oe` puts them into kit.toml and
# level-kit.md with what the model and the asset map say. Rules, sizes,
# counts and boxes only: no table of the ROM. CPU addresses name where a
# rule was read; the model's notes and the asset map cite the same.
format = "0.1.0"
summary = """
A stage is one screen of 256 by 240 pixels: six sloped girders and a short top platform, joined by ladders, full and broken. The thrower (`kong`) on the top girder rolls barrels down; each rolls along its girder, drops off its end or down a ladder to the one below, and ends in the oil drum at the bottom left, which lets out fires that wander the girders and climb their own ladders. The hero starts on the bottom girder, can take one of two hammers, and clears the stage by climbing to the top platform where the one to rescue (`pauline`) waits. The rules below are for a stage that runs on the game's own engine, as 25m's replacement: the model runs any layout, but the engine reads the stage from fixed places in a fixed format, and some of the stage is numbers in its code.
"""

open = [
  "The stage picture's bytes are counted by hand (packP); a tool that encodes a layout entry and reports the space left would replace it",
  "The rules fixed in code were read from the model's notes and packP's and gcFit's work, not from a detector; docs/research/deterministic-inference.md lists a code-immediate finder as the tool that would find them",
  "Whether the attract demo's script must stay within 20 holds when packed (its table's size) is not checked",
  "The 75m and 100m stages have no kit: the model holds only 25m",
]

[[data]]
what = "Girders"
rule = "Runs of 6 bytes the walk's ground test reads ($D91A): x, y, the piece's shape, the step across (signed), the count of 24 px pieces, each a pixel higher than the last, and an end mark (0, or $FE to end the row)"
slot = "ground_runs"
source = "the asset map's note; packP's pack, 2026-11-04"

[[data]]
what = "Girder pieces' shapes"
rule = "A box by shape, 4 bytes: left, top, right and bottom from the piece's place. 25m has 3 (a long flat piece, a 24 px piece and the top platform's)"
slot = "ground_shapes"
source = "the asset map"

[[data]]
what = "Ladders"
rule = "3 bytes a ladder: x, y and a shape; each shape is a box of 4 bytes, left, top, right and bottom from the ladder's place. The list ends with $FE. A broken ladder is one whose box stops short of the girder above"
slot = "ladders"
source = "the asset map; the ladder routine $D28B, $D8AD tests the hero's feet box against each"

[[data]]
what = "Ladder tops and the climb's pictures"
rule = "The tops the climb finds (up to 9, then an end mark), the top zone's box, the 16 pictures of a climb over a top and the 6 of a step"
slot = "climb_rom"
source = "the model's climb_rom slot ($C127)"

[[data]]
what = "Girder heights"
rule = "The rows that say which girder a body is on (7 thresholds), read by the fires and the edge test"
slot = "play_heights"
source = "the model's play_heights slot ($C0BC)"

[[data]]
what = "Gaps under the girders' ends"
rule = "The places a walk off a girder's end drops through, and their boxes"
slot = "play_gaps"
source = "the model's play_gaps slot ($C0CF, $C0DF)"

[[data]]
what = "The slope list"
rule = "9 x places where a girder steps a pixel, shared by barrels and fires: a barrel on girders 2 to 5 steps at each, on girders 1 and 6 from the fifth on; a fire steps at 24 (in code) and at the list from its second. Each is a piece's step less 8, the middle of a 16 px sprite"
slot = "play_tables"
source = "$C1C4; gcFit's notes in scripts/rivet-rodeo/stage.py (in progress, 2026-11-04)"

[[data]]
what = "Barrels' ladders"
rule = "Two ladders a girder for girders 2 to 6, each an x and a foot row (20 bytes): the ladders a barrel may take down"
slot = "play_tables"
source = "$C172 to $C185; packP's pack"

[[data]]
what = "Broken ladders' stops"
rule = "A box at the top of each broken ladder that stops the hero's climb: x, y, 0, ended by $FE"
slot = "play_tables"
source = "$C161; packP's pack"

[[data]]
what = "Straight drops"
rule = "Three ways a barrel can drop straight down the stage, each 5 rows where it stops"
slot = "play_tables"
source = "three tables after the slope list; the barrel's straight*_stop params"

[[data]]
what = "Hammers and the hero's start"
rule = "Two hammers, an x and a y each; the hero's start as its sprite's x (the model's x less 5) and y"
slot = "play_tables_c2f0"
source = "$C4CB, $C4D1, $C4E3; packP's pack"

[[data]]
what = "The stage's picture"
rule = "PPU update strings that draw the girders, ladders and drum, with 25m's palettes: what the screen shows. Play never reads it, so it must agree with the girders and ladders above"
slot = "stage_screens"
source = "the asset map: entry screen_25m"

[[data]]
what = "The attract demo"
rule = "The demo's moves: up to 20 holds, a way and a frame count each"
slot = "demo_script"
source = "the model's demo_script slot"

[[code]]
what = "Rows of runs"
rule = "The ground test reads row 1 as two runs at the list's start and row n (2 to 7) as one run at byte 12 + 6(n - 2): the bottom girder has exactly 2 runs and every other row exactly 1, 8 runs in all"
source = "$D91A; packP's pack, gcFit's notes"

[[code]]
what = "Sloped ends"
rule = "A run is one straight slope of 24 px pieces, each a pixel higher than the last in its direction, so a girder above the bottom slopes from end to end; a flat part needs a run of its own, which only the bottom row has (25m's: flat to x 128, then sloped)"
source = "gcFit's notes"

[[code]]
what = "Fires' ladders"
rule = "Fires climb 4 ladders whose x, top and foot are numbers in the fire routine's code ($E626, $E640 to $E697): two from the bottom girder (x 92 and 196) and two from the second (x 44 and 108), the model's fire ladder_* params. A stage keeps ladders where fires climb, or the code changes"
source = "the model's note on entities.fire; packP's pack patched these as code"

[[code]]
what = "The third barrel ladder"
rule = "Barrels take a third ladder only on girders 4 and 5, its x and foot in code ($E0D1, $E0DD; the model's barrel ladder_c4 and ladder_c5, foot 14 over girders 3 and 4)"
source = "packP's pack, gcFit's notes"

[[code]]
what = "The throw"
rule = "The thrower lets a barrel go at x 77, y 50 (the barrel's let_go_x and let_go_y), so girder 6 lies 64 px under the thrower and steps a pixel only from the slope list's fifth place on"
source = "the model's barrel params; gcFit's notes"

[[code]]
what = "A pushed barrel's drop"
rule = "A barrel the hammer holder's crowd pushes through girder 3 or 5 drops 21 px and 2 more each 24 across, so girders 2 and 4 must lie under 3 and 5 as 25m's do"
source = "the barrel's crowd and crowd_drop params; gcFit's notes"

[[code]]
what = "The drum and the fires' way out"
rule = "The drum's flames are at x 32, y 192 and a fire comes out at x 32, y 184 (the drum's out_x and out_y): the bottom girder's left end holds the drum"
source = "the model's oil_drum spawn and params"

[[code]]
what = "Screen edges"
rule = "The hero's walk stops at x 21 and 229 ($D990); barrels fall at x 19 and 219 and bounce on to x 31 when they land on an even girder; fires turn at x 12 and 212 (228 on the bottom girder)"
source = "the hammer's left_edge and right_edge, the barrel's edge_left and edge_right, the fire's edge params"

[[code]]
what = "The goal and the top"
rule = "The stage is cleared when the hero's top is above row 29 (the model's goal under); only standing on the top platform does that: the hero stands 12 rows under its top, so the platform must stand at row 40 or above, and a full ladder must reach it from girder 6"
source = "the model's levels.main.goal"

[[code]]
what = "The thrower's place"
rule = "The thrower stands at x 32, y 32, where the throw's numbers (above) assume him; his six poses are fixed pictures of 24 tiles each"
source = "the kong spawn; the kong_* slots"

[[limit]]
what = "Girder runs"
limit = "8 runs, 48 bytes: 2 on the bottom row, 1 on each of 6 rows above"
why = "the row rule; 9 runs spill 6 bytes into the shapes"
source = "the asset map (ground_runs_25m: 8 rows of 6); packP's pack"

[[limit]]
what = "Girder shapes"
limit = "3 shapes, 12 bytes"
why = "a fourth must move elsewhere with its pointer (packP moved heights and shapes into 100m's ladder list)"
source = "the asset map; packP's pack"

[[limit]]
what = "Ladders"
limit = "13 ladders (39 bytes) and an end mark; 7 shapes (28 bytes)"
why = "the list is followed by other tables"
source = "the asset map (ladders_25m: 13 rows of 3; ladder_shapes_25m: 7 of 4)"

[[limit]]
what = "Broken ladders"
limit = "4"
why = "the stop boxes' list is 13 bytes"
source = "$C161; packP's pack"

[[limit]]
what = "Ladder tops"
limit = "9"
why = "the climb's top list"
source = "climb_rom"

[[limit]]
what = "Barrel ladders"
limit = "2 on each of girders 2 to 6, a third on girders 4 and 5 only"
why = "the table and the code"
source = "packP's pack"

[[limit]]
what = "Fire ladders"
limit = "4, at x 92 and 196 from the bottom girder and 44 and 108 from the second, unless the code changes"
source = "the fire's params"

[[limit]]
what = "Hammers"
limit = "2"
source = "$C4CB, $C4D1"

[[limit]]
what = "The screen"
limit = "256 by 240 px; girders between x 0 and 256, the hero's walk from x 21 to 229; a body below row 232 is out"
source = "the model"

[[limit]]
what = "Space for the stage's picture"
limit = "1258 bytes hold all five screens: 25m 449, 75m 177, 100m 268, the title 322, the status box 42. A new 25m with the others kept has 449 bytes; with 75m and 100m dropped, 894"
why = "Rivet Rodeo's 25m picture is 569 bytes (120 over 449), its title 523"
source = "the asset map (stage_screens: 1258 bytes, 5 entries); packP's pack, 2026-11-04"

[[limit]]
what = "Tiles"
limit = "256 background tiles and 256 sprite tiles, 8 KB of CHR in all"
source = "the asset map"

[[measure]]
name = "girders"
what = "Girders, and the top platform"
target = "6 + 1"
within = "1"
example = "6 + 1"
source = "docs/originals.md, Rivet Rodeo's measures of 2026-11-03"

[[measure]]
name = "slope_px_per_24"
what = "Slope, pixels per 24 across, bottom to top"
target = [-0.53, 0.88, -0.88, 0.88, -0.88, 0.83]
within = "0.25 each"
example = [-0.56, 0.88, -0.77, 0.88, -0.77, 0.69]
source = "docs/originals.md"

[[measure]]
name = "gaps"
what = "Gaps between girders' middles, px"
target = [31, 30, 30, 30, 29, 25]
within = "8 px each"
example = [30, 30, 30, 30, 30, 26]
source = "docs/originals.md"

[[measure]]
name = "ladders, broken"
