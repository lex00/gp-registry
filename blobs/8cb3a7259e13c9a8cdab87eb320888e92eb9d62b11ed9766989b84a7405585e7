[[verify]]
step = "1. The model's own checks"
how = "Write the stage as data (a derived template's authored.toml, as scripts/rivet-rodeo/stage.py does), then gp template derive T --write, gp template build T --write and gp template check T: every slot filled, the pins current"

[[verify]]
step = "2. The play measures"
how = "gp level measure --template T: each measure above within its tolerance. --clears 3 plays the route with the barrels and fires in and prints the holds a baseline takes"

[[verify]]
step = "3. Originality"
how = "gp template check T --original with your ROM in $GP_ROM_DIR: cells and ladders under the thresholds, no shared data line"

[[verify]]
step = "4. Baselines"
how = "Write the holds from step 2 as a model baseline (docs/originals.md, \"Model baselines\") and run gp interp baselines T"

[[verify]]
step = "5. The real engine"
how = "Pack the stage's slots into a copy of your ROM at 25m's places in 25m's formats, outside the repo (packP's script did it by hand; gp assets pack writes slots that keep their sizes), then run the same inputs on the model and on the copy: gp interp compare T --rom COPY --input LOG --assets LIFT --mode free. A slot that doesn't fit its place, or a rule fixed in code, is where a run first splits from the model where Donkey Kong's own doesn't. Never commit the copy"

[[verify]]
step = "6. A theme"
how = "gp theme check T --theme DIR: a theme's floors and sprites must keep the stage's geometry (docs/theme-kit.md, \"Gameplay geometry\")"

[[fit]]
what = "Rivet Rodeo's girders as of 2026-11-03"
rule = "9 runs (a run per flat stretch and slope), 54 bytes: 6 over the 48. They fit only rewritten: one run a row, as gcFit's redesign does"
source = "packP's pack, 2026-11-04"

[[fit]]
what = "Shapes and heights"
rule = "Rivet Rodeo needs 4 ground shapes against 25m's 3; packP moved the heights and shapes into 100m's ladder list and pointed 25m at them, which breaks 100m"
source = "packP's pack"

[[fit]]
what = "Ladders, tops, stop boxes, barrel ladders, slope list, hammers, start, demo"
rule = "All fit 25m's places and formats as data: 13 ladders and 7 shapes, 9 tops, 4 stop boxes, 2 barrel ladders a girder, 9 slope places, 2 hammers"
source = "packP's pack"

[[fit]]
what = "Fires' ladders and the third barrel ladder"
rule = "Only by changing code: packP rewrote 12 numbers of the fire routine and 4 of the barrels' third-ladder test, and swapped the girder 3 and 5 branches. gcFit's redesign keeps them where the code has them instead, so no code changes"
source = "packP's pack; gcFit's notes"

[[fit]]
what = "The stage's picture"
rule = "569 bytes against 449: it fits only with 75m's and 100m's pictures dropped (1129 of 1258 bytes with Rivet Rodeo's title and status box)"
source = "packP's pack"

[[fit]]
what = "Runs on the real engine"
rule = "Rivet Rodeo packed, the same inputs run on the copy and on the model: the first splits Donkey Kong's own runs don't have came at model frame 640 (a climb: the hero's y 204 on the engine, 203 on the model), 705 (a jump: a sound), 811 (a start: a barrel) and 1079 (a climb: a death's wait)"
source = "packP's runs, model frames, 2026-11-04"

[example]
template = "rivet-rodeo"
text = [
  "Rivet Rodeo is an original stage on this model (docs/originals.md). Its girders are 25m's in kind and spacing: six girders about 30 px apart at their middles, sloping a pixel each 24 px piece, the bottom one flat for its left half, and a top platform. Its ladders, hammers and start are its own places, and gp template check --original holds it apart from 25m: cells 0.472 at a shift of 2 cells, ladders 0.385 (5 of 13), both under the thresholds.",
  "Against the format: it keeps the counts (13 ladders, 4 broken, 9 tops, 2 hammers), the slope list and the screen edges, so those slots pack into 25m's places. It breaks two rules: it writes its girders as 9 runs (a run per flat stretch and slope), where the format holds 8, one a row above the bottom; and its ladders don't stand where the code has the fires' ladders (x 92 and 196 from the bottom girder, 44 and 108 from the second) and the third barrel ladder. The model runs it anyway, since the model reads the runs and the fire params as data; the real engine does only with code changed (What fits, above).",
  "Its measures land within the tolerances: the slopes within 0.14 (girder 6: 0.69 against 0.83), the gaps within 1 px, the route 1148 frames against 1160, the throw to the drum 982 against 1003, the jump window 19 against 22.",
  "gcFit's redesign (in progress on 2026-11-04) keeps to every rule above: one run a row, girders 1 to 3 laid so the fires' ladders stand on them, a ladder where the third barrel ladder is on girders 4 and 5, and girder 6 64 px under the thrower.",
]
