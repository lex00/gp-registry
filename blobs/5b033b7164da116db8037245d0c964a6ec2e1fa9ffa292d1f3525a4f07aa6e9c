[[field]]
note = "Mario's x: the sprite buffer's $0203 + 5. $46 holds the same on every frame of the user's walk clips, but while Mario holds the hammer the box set-up at $EFF5, called with the hammer's head at $D753-$D7BC, puts the hammer's hit point in $46 and $47 instead (hammer session clip 3, frames 6764 to 6800), so the sprite buffer is read"
offset = 5
path = "entities.player[0].x"
ram = [515]
whole = true

[[field.case]]
unmeasured = "From 100m's ending's $9E ($CBAE moves every sprite off, $0200 255) to its $85, and from its end ($CA53) to the next stage's start, Mario's sprite holds no place; at $85 the ending draws him at $A0, $30 ($CE4F)"
when = "ram[0x0200] == 255 && ram[0x0053] == 1 && ram[0x0054] != 0 && (ram[0x004f] == 0 || ram[0x009a] != 0 || ram[0x044f] == 8)"

[[field.case]]
unmeasured = "In donkey-kong-oe's stage-clear scene, from its step 3 ($0450, $8B03, the clear's 5th divider wrap) until the next stage's setup clears the sprites, the game draws Kong carrying Pauline up in the sprite buffer: Mario's sprite holds Pauline. donkey-kong-ju sets $0450 only in 100m's scene ($CCF4)"
when = "ram[0x0450] >= 3"

[[field.case]]
unmeasured = "The GAME OVER text's sprite (tile 162 at x 56, y 127) keeps the first slot after Start begins the new game ($55 back to 3) until the screen is cleared for it (barrels clip 1, frames 5372 to about 5700)"
when = "ram[0x0201] == 162 && ram[0x0096] == 255"

[[field.case]]
unmeasured = "Late in a death's wait the game clears the sprites to redraw the screen, Mario's too ($0200 at 255), until it draws him at his start; $0203 and $0200 hold no place of his then"
when = "ram[0x0096] == 255 && ram[0x0200] == 255"

[[field.case]]
unmeasured = "On the 18th divider wrap of the stage-clear scene the game clears the sprites, Mario's too ($0200 at 255), until the next stage draws him at its start (clear-25m clip 1, frames 3359 to 3568); a new game's setup does the same ($CBAE), whatever Mario was doing when Start was pressed in the demo"
when = "(ram[0x004f] == 0 || ram[0x009a] != 0) && ram[0x0200] == 255"

[[field.case]]
unmeasured = "From power-on until the first stage starts Mario has no place: the title's cursor is the first sprite, then the stage setup draws him at his start"
when = "ram[0x0096] == 0"

[[field.case]]
unmeasured = "On the title ($4E set, $55 not 0) the first sprite is the cursor, at x 56, not Mario's; his place stays in $46 and $47 (game-over clip 1, from frame 30013)"
when = "ram[0x004e] == 1 && ram[0x0055] != 0"

