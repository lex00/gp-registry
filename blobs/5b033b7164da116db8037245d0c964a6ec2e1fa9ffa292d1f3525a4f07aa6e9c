# The state mapping (docs/formats/state-mapping.md) for Donkey Kong:
# Original Edition: where each model value is in the original's RAM.
# Until 2026-11-06 it was derived from templates/donkey-kong-ju (gp
# template derive); it is this template's own now.
align = "polled"
description = "The player's place, measured"
model = "donkey_kong_oe"
read_at = "nmi"
schema = 22
score_draws = true
source = "donkey-kong-oe"

