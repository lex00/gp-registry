# Template manifest (docs/templates.md, docs/originals.md). Rivet Rodeo is
# an original stage on Donkey Kong's model and rules: the public page plays
# it when no ROM is loaded (docs/web.md, "The public page"). Its assets are
# written in authored.toml by scripts/rivet-rodeo/stage.py, and
# `gp template build` makes the data image and asset map the pins name.
#
# It is derived (docs/templates.md, "Derived templates"): model.toml and
# the other per-game files are Donkey Kong: Original Edition's
# (templates/donkey-kong-oe), renamed to this source, with delta.toml
# merged over them by `gp template derive`. Never edit the
# derived files; change scripts/rivet-rodeo/stage.py and run it.
[template]
format = "0.3.2"
id = "rivet-rodeo"
title = "Rivet Rodeo"
tier = "open"
model = "model.toml"
contract = "fidelity.toml"

[source]
id = "rivet-rodeo"
platform = "nes"
how = "authored"
accepts = ["a92040fce4409f1e51d9003fd0fd5a423275277fa1c8927e2f69be9ca55f924e"]

[recipe]
asset_map = "assets/rivet-rodeo.toml"
asset_map_sha256 = "2adb85d96a6b74ddabf32f90080d048a4cd47f6f26effde2b8ea89f4fe404f62"
lifted_sha256 = "b4a9838176c0b8c8fac0a47ebb885172b9bbaca18fabab7b7330e306646f0cfa"

[derive]
from = ".."
delta = "delta.toml"
# Rivet Rodeo's generator, which `just derive rivet-rodeo` runs after the
# derive (docs/templates.md, "Re-deriving"): stage.py and art.py write
# authored.toml, delta.toml and the art, then the derive, build, theme kit
# and paper paint follow from them.
generate = [
  "python3 -I open/generators/stage.py",
  "$GP template derive open --write",
  "$GP template build open --write",
  "$GP theme kit open",
  "$GP theme paint open -o open/themes/paper --logo-file open/generators/title.txt --force",
]

