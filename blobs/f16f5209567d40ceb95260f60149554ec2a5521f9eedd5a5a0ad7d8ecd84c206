# Template manifest (docs/templates.md) for Donkey Kong: Original Edition,
# the NES source of the game donkey-kong that this project models
# (sources/nes.toml, donkey-kong-oe; the user's decision, ROADMAP.md
# 2026-11-04). A CNROM board: its upper 16KB is the program of Donkey Kong
# (JU) with jumps into a new lower 16KB (50m and the title). A commercial
# game: it ships with no assets and no facts.
#
# A Donkey Kong (JU) ROM may be loaded to play this model ([[loads]]
# below); nothing scores, gates, records clips on or derives from it.
[template]
format = "0.3.1"
id = "donkey-kong-oe"
title = "Donkey Kong: Original Edition"
tier = "commercial"
model = "model.toml"
contract = "fidelity.toml"
clips = "corpus.toml"
game = "donkey-kong"

[source]
id = "donkey-kong-oe"
platform = "nes"
how = "rom"
accepts = ["45440d8ef512b4660dce0c753e110004aef96fa30f2967f9260e946d808db07d"]

[recipe]
asset_map = "assets/donkey-kong-oe.toml"
asset_map_sha256 = "35b718d26e02b60ce9bd523dd5ea59f3537d78e8074effad5824a045f6406d10"
lifted_sha256 = "3471247780a92d9af74e2d7fd2713926229df71f2e94bb45162e5221bba129cc"

# A ROM a person may load to play this model, which is not a source: no
# tool scores, gates, records clips on or derives from it (docs/templates.md,
# "ROMs to play"). Donkey Kong (JU) is this game's upper half without 50m
# (the user's decision, ROADMAP.md 2026-11-04). Its assets are lifted
# through its own asset map; `assets` names its asset each of this model's
# assets it lacks takes instead (the title is an entry of its stage
# screens, drawn with its one set of tiles), and the rest (50m's, the
# jingles in the lower half) are filled from the paper version. `levels`
# are the ones it has: the game passes over the others (stages.skip), so
# a JU player goes 25m, 75m, 100m, as JU does.
[[loads]]
source = "donkey-kong-ju"
accepts = ["aa408f5a6b97c0d738e7e8b489a5617ad4a9ecdee2b05c4ee504210ce31b2825"]
asset_map = "assets/donkey-kong-ju.toml"
asset_map_sha256 = "4a968562f81777d7e2349f65543ead02b09ad7b15794d15c63299773dbba4383"
levels = ["main", "m75", "m100"]
assets = { title_screens = "stage_screens", title_tiles = "tiles", title_sprite_tiles = "sprite_tiles" }

