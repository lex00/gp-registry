[evidence."counters.death_wait"]
source = "observed"
confidence = 85
note = "After the spin ends ($98 = 255), the game starts again on a divider wrap ($34 back to 10) 344 to 354 frames later: 2333 -> 2677 (344, $34 at 2), 3576 -> 3920 (344, $34 at 2) and 7795 -> 8144 (349, $34 at 7) in barrels clip 1, each the 32nd wrap after the spin's end; the walk-off death's 345 and the barrel death's 351 that worker E saw are the same rule. On every stage but 25m the wait routine ($CAC9) takes one more from $43 on the frame it reaches $84 ($CAD2, $CB15), so the wait there is a wrap shorter: the dk_mario hook takes death_wait and setup_wait one more on the wrap that makes death_wait 29 (m75 clip 11, frame 1797: $43 133 to 131)"

