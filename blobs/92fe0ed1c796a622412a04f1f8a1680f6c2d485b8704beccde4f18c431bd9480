[model]
schema = "0.4"
name = "rivet_rodeo"
title = "Rivet Rodeo"
description = "Rivet Rodeo, an original stage on Donkey Kong's model and rules (templates/donkey-kong-oe), for the public page with no ROM: its girders, ladders, tables and pictures are authored in templates/rivet-rodeo, laid out by scripts/rivet-rodeo/stage.py"
source = "rivet-rodeo"
view = "side"
frame_rate = "39375000/655171"
systems = ["rules", "entity_states", "counters", "spawn", "platformer.player", "platformer.enemies", "platformer.contact", "exits", "camera"]
start_level = "main"
events = ["player.fell", "player.lost", "barrel.smashed", "barrel.jumped", "prize.taken", "rivet.removed", "bonus.due", "play.resumed", "bonus.late", "smash.done", "game.started", "game.ended", "demo.started", "demo.ended", "demo.start", "turn.ended", "turn.swap", "over.kept", "rivets.cleared", "ending.tally", "ending.hide", "stage.draw", "bonus.added", "stage.setup", "stage.entered"]

[model.extensions]
platformer = "0.4"

[input]
device = "nes-pad"
keep_direction = true

[input.actions]
down = "down"
jump = "a"
left = "left"
pause = "start"
right = "right"
select = "select"
up = "up"

[input.turn]
counter = "player"
actions = ["left", "right", "up", "down", "jump"]

