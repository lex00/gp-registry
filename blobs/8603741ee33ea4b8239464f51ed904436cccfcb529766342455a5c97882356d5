# Prompt words for donkey-kong-oe's theme kit (docs/theme-kit.md, "Prompt words"),
# written by hand from watching the template's clips. `gp theme kit`
# puts the labels, descriptions and poses into kit.toml. `deny` lists the
# words no prompt-facing text may hold; `note` keeps the game's own term
# and never reaches the kit.
format = "0.1.0"
deny = ["donkey", "kong", "mario", "jumpman", "pauline", "barrel", "girder", "oil drum", "oil", "drum", "hammer", "mallet", "ape", "gorilla", "monkey", "damsel", "princess", "lady", "plumber", "carpenter", "mustache", "moustache", "overalls", "cap", "nintendo", "rivet"]

[[art]]
id = "entity.barrel"
label = "rolling hazard"
description = "a small round hazard the big foe sends rolling down the sloped platforms and sometimes down a ladder, 16 by 16 pixels; the hero jumps over it or smashes it"
poses = [
    "rolling, seen from the side, a stripe from lower left to upper right",
    "breaking apart: a large hollow ring",
    "breaking apart: a small hollow ring",
    "breaking apart: a tiny spark",
    "breaking apart: a burst of short rays",
    "tumbling down a ladder, seen front on, dark band across the middle",
    "tumbling down a ladder, seen front on, light band across the middle",
    "tumbling down a ladder, seen front on, dark band, bright rims",
    "tumbling down a ladder, seen front on, dark band, first turn",
    "tumbling down a ladder, seen front on, dark band, second turn",
    "rolling, seen from the side, a stripe from upper left to lower right",
    "held still, seen front on, before its first roll (the same picture as while the big foe holds it)",
    "rolling, seen from the side, a stripe from lower left to upper right",
    "rolling, seen from the side, a short stripe pointing down right",
    "rolling, seen from the side, a short stripe pointing up right",
    "rolling, seen from the side, a stripe nearly level",
    "tumbling down a ladder, seen front on, dark band (another turn)",
    "tumbling down a ladder, seen front on, light band (another turn)",
]
note = "the game's barrel"

